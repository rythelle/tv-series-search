# Optional: copy this file to .env to override the Docker Compose defaults.
# A fresh clone runs without this file and without an API key.

APP_PORT=7777
DATABASE_URL=postgresql://app:app@db:5432/tvseries

SEARCH_CACHE_TTL_SECONDS=60
POPULAR_CACHE_TTL_SECONDS=300
SHOW_STALE_AFTER_SECONDS=86400
# Minimum word_similarity() between the query and the best matching extent
# of a title. Below ~0.4 three-letter names match any query sharing their
# first two letters ("DEA" scores 0.4 against "dext").
TRIGRAM_WORD_SIMILARITY_THRESHOLD=0.5
SEARCH_RESULT_LIMIT=20

TVMAZE_TIMEOUT_SECONDS=5
TVMAZE_BREAKER_FAILURES=5
TVMAZE_BREAKER_COOLDOWN_SECONDS=30

COMMENT_MAX_LENGTH=1000
COMMENTS_PAGE_SIZE=50

# AI_PROVIDER: huggingface | gemini | anthropic | openai | heuristic
# Leave AI_API_KEY empty to use the built-in insight fallback.
# For Hugging Face, create a fine-grained token with Inference Providers permission.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=2
AI_BREAKER_FAILURES=3
AI_BREAKER_COOLDOWN_SECONDS=60
AI_MAX_CONCURRENCY=4
AI_PROMPT_COMMENT_COUNT=10
AI_PROMPT_MAX_CHARS=4000

INSIGHT_CACHE_TTL_SECONDS=86400
INSIGHT_FALLBACK_TTL_SECONDS=300

RATE_LIMIT_PER_MINUTE=120
INSIGHT_RATE_LIMIT_PER_MINUTE=10

SEED_ON_START=true
# TVMaze serves 250 shows per index page. This is the browsable shelf, a slice
# of the catalog rather than a mirror of it -- search reaches everything else.
SEED_PAGES=3
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
